# Chiave API di Anthropic — creala su https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modello Claude per le risposte (default: claude-opus-4-8, il più capace della fascia Opus).
# Per ridurre i costi puoi usare: claude-sonnet-5 oppure claude-haiku-4-5
CLAUDE_MODEL=claude-opus-4-8

# (Opzionale) Collegamento SENZA QR code, comodo da iPhone o server remoto:
# inserisci il numero WhatsApp del bot (solo cifre, con prefisso internazionale,
# es. 393331234567). All'avvio riceverai un codice di 8 caratteri da digitare in
# WhatsApp → Dispositivi collegati → Collega un dispositivo → "Collega con numero
# di telefono". Lascia vuoto per usare il classico QR code.
PAIRING_PHONE_NUMBER=

# Secondi di attesa prima di rispondere (raggruppa i messaggi ravvicinati del contatto)
DEBOUNCE_SECONDS=5

# Minuti di pausa del bot in una chat dopo che rispondi TU manualmente
TAKEOVER_MINUTES=60

# Numero massimo di messaggi ricordati per conversazione
MAX_HISTORY=40

# ── Risposte vocali con la "segretaria virtuale" (opzionale) ─────────────────
# Chiave API ElevenLabs — https://elevenlabs.io (piano gratuito per provare).
# Se lasci vuoto, il bot funziona solo in modalità testo.
ELEVENLABS_API_KEY=

# Voce della segretaria: ID di una voce presa da https://elevenlabs.io/app/voice-library
# Default: "Sarah", voce femminile predefinita che parla italiano.
# CONSIGLIO: per una voce MOLTO più naturale, scegli una voce NATIVA italiana
# dalla Voice Library (filtra per lingua "Italian"), apri la voce, copia il suo
# Voice ID e incollalo qui. Una voce nativa suona molto meglio di "Sarah".
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Espressività della voce (facoltativo: i default vanno già bene).
#   ELEVENLABS_STABILITY   0.0–1.0  (più bassa = più espressiva; troppo bassa = instabile)
#   ELEVENLABS_SIMILARITY  0.0–1.0  (più alta = più fedele al timbro della voce)
#   ELEVENLABS_STYLE       0.0–1.0  (più alta = più intonazione/emozione)
# ELEVENLABS_STABILITY=0.4
# ELEVENLABS_SIMILARITY=0.85
# ELEVENLABS_STYLE=0.35

# Quando rispondere a voce:
#   auto   = solo quando il contatto manda un vocale (consigliato)
#   always = tutte le risposte sono vocali
#   off    = mai
VOICE_REPLIES=auto

# Lettura dei vocali IN ARRIVO. Al momento c'è un bug di WhatsApp Web (non
# nostro) che impedisce di scaricare i vocali: per questo il default è "off",
# e il bot chiede cortesemente al contatto di scrivere in testo. Quando la
# libreria verrà aggiornata potrai riattivare la lettura con VOICE_TRANSCRIBE=on
VOICE_TRANSCRIBE=off

# (Opzionale) Percorso di un Chromium/Chrome già installato, se Puppeteer non lo scarica da solo
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# (Opzionale, solo per diagnosticare problemi di avvio) mostra la finestra di
# Chromium invece di tenerla nascosta. Utile se il bot si blocca subito con
# errori tipo "Execution context was destroyed".
# PUPPETEER_HEADLESS=false
